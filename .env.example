# Copy this file to .env and fill in only the keys the current phase needs.
# Never commit .env.

# --- Local pipeline ---
DDS_DATA_DIR=data
# DDS_DATABASE_PATH=data/dds.db
DDS_LOG_LEVEL=INFO

# --- Episode discovery (phase 2) ---
DDS_PLAYLIST_URL=

# --- Recommendation extraction (LLM) ---
# One of: gemini | groq | opencode
PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=

# Optional alternative extraction provider
OPENCODE_API_KEY=
OPENCODE_MODEL=
OPENCODE_FALLBACK_MODELS=

# --- Transcription ---
GROQ_API_KEY=
GROQ_MODEL=

# --- Metadata: movies, series and availability ---
TMDB_TOKEN=

# --- Metadata: videogames ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
