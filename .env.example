# Copy this file to .env and fill in only the keys the current phase needs.
# Never commit .env.

# --- Local pipeline ---
DDS_DATA_DIR=data
# DDS_DATABASE_PATH=data/dds.db
DDS_LOG_LEVEL=INFO

# --- Episode discovery ---
DDS_PLAYLIST_URL=
# Seconds between metadata calls
DDS_SYNC_DELAY_S=2
# Refuse a listing with fewer than this share of the known episodes
DDS_SYNC_MIN_RATIO=0.5
# DDS_YT_DLP_PATH=yt-dlp
# DDS_YT_DLP_TIMEOUT_S=120

# --- Audio window ---
DDS_AUDIO_QUALITY=48K
# DDS_AUDIO_TIMEOUT_S=600

# --- Recommendation extraction (LLM) ---
# One of: gemini | groq | opencode
PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=

# For extraction with Groq, use a chat model, not the transcription model.
GROQ_CHAT_MODEL=
GROQ_CHAT_FALLBACK_MODELS=

# Optional alternative extraction provider
OPENCODE_API_KEY=
OPENCODE_MODEL=
OPENCODE_FALLBACK_MODELS=
# OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1

# DDS_EXTRACT_TIMEOUT_S=180

# --- Transcription ---
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3
# DDS_TRANSCRIBE_TIMEOUT_S=300

# --- Metadata: movies, series and availability ---
TMDB_TOKEN=

# --- Metadata: videogames ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
